# ============================================
# VARIABLES DE ENTORNO - SERVIDOR
# ============================================

# Base de datos PostgreSQL
# Local: postgresql://usuario:contraseña@localhost:5432/biblioteca_v2
# Supabase: postgresql://postgres.[proyecto].supabase.co:5432/postgres
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/biblioteca_v2"

# Conexión directa (requerido para Vercel con Supabase)
# Mismo valor que DATABASE_URL pero sin usar connection pooling
DIRECT_URL="postgresql://usuario:contraseña@localhost:5432/biblioteca_v2"

# Puerto del servidor (en local)
PORT=3000

# Environment
NODE_ENV="development"

# JWT Secret (cambiar por un valor seguro en producción)
JWT_SECRET="tu_secret_jwt_super_seguro_aqui_cambiar_en_produccion"

# API Resend para envío de emails
RESEND_API_KEY="re_xxxxx"

# ============================================
# VARIABLES DE ENTORNO - CLIENTE
# ============================================

# URL del API (cambiar según el ambiente)
VITE_API_URL="http://localhost:3000"

# ============================================
# INSTRUCCIONES PARA LLENAR
# ============================================
#
# 1. Copiar este archivo a .env en ambas carpetas:
#    cp .env.example server/.env
#    cp .env.example client/.env
#
# 2. Reemplazar los valores marcados con:
#    - DATABASE_URL: Tu string de conexión PostgreSQL
#    - JWT_SECRET: Un string aleatorio seguro
#    - RESEND_API_KEY: Tu API key de Resend (opcional)
#    - VITE_API_URL: URL del backend (local: http://localhost:3000)
#
# 3. Para producción en Vercel:
#    - DATABASE_URL y DIRECT_URL: De Supabase
#    - JWT_SECRET: Valor único y seguro
#    - VITE_API_URL: URL del backend en producción
#
# 4. NUNCA commitear .env a git - está en .gitignore
