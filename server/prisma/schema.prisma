generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. Usuarios del sistema (Administradores y Llectores)
model User {
  id        Int      @id @default(autoincrement())
  name      String
  lastname  String
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  loans     Loan[]
}

enum Role {
  USER
  ADMIN
}

// 2. Categorías / Géneros literarios
model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique // Ej: Ciencia Ficción, Historia, Novela

  books Book[]
}

// 3. Catálogo de Libros
model Book {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  isbn        String?  @unique
  publishedAt Int?
  copies      Int      @default(1)
  available   Int      @default(1)
  imageUrl    String?   // URL de la portada
  createdAt   DateTime @default(now())

  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])

  loans       Loan[]
}

// 4. Registro de Préstamos
model Loan {
  id         Int        @id @default(autoincrement())
  loanDate   DateTime   @default(now())
  returnDate DateTime?  // Fecha real en que devolvió el libro
  dueDate    DateTime   // Fecha límite para devolver
  status     LoanStatus @default(ACTIVE)

  // Relación con Usuario
  userId     Int
  user       User       @relation(fields: [userId], references: [id])

  // Relación con Libro
  bookId     Int
  book       Book       @relation(fields: [bookId], references: [id])
}

enum LoanStatus {
  ACTIVE    // En préstamo
  RETURNED  // Devuelto
  OVERDUE   // Atrasado / Vencido
}
